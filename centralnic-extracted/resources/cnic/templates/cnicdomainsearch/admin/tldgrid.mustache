<div class="item" data-category="{{id}}" data-name="{{name}}" data-icon="{{settings.icon}}">
    <div class="item-content">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <span class="dropcat fa fa-times"></span>
                #<span class="cat-order">{{position}}</span>
                {{name}}
                <i class="fas fa-{{settings.icon}}"></i>
                <i class="fas fa-sort pull-right text-md"></i>
                <button type="button" class="btn btn-primary edit-category pull-right">
                    <i class="fas fa-pencil-alt"></i> Edit
                </button>
            </div>
            <div class="panel-body">
                <div class="tldgrid" data-category="{{id}}">
                    {{#tlds}}
                        {{ >tldgriditem}}
                    {{/tlds}}
                </div>
            </div>
        </div>
    </div>
</div>